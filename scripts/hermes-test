#!/usr/bin/env python3
"""Dispatch Hermes tests to an isolated GitHub Actions job-container."""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
from pathlib import Path
import re
import secrets
import subprocess
import sys
import time

WORKFLOW = "isolated-hermes-tests.yml"
REMOTE_REPO = "djagya/hermes-agent"
TARGET_RE = re.compile(r"tests/[A-Za-z0-9_./-]+\.py(?:::[A-Za-z0-9_.\[\]-]+)*")


class Refusal(RuntimeError):
    pass


def run(*args: str, cwd: Path | None = None, check: bool = True) -> subprocess.CompletedProcess[str]:
    proc = subprocess.run(
        args,
        cwd=cwd,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if check and proc.returncode:
        detail = (proc.stderr or proc.stdout).strip()
        raise Refusal(f"command failed ({proc.returncode}): {' '.join(args)}\n{detail}")
    return proc


def discover_repo(explicit: str | None) -> Path:
    start = Path(explicit).expanduser().resolve() if explicit else Path.cwd()
    proc = run("git", "-C", str(start), "rev-parse", "--show-toplevel", check=False)
    if proc.returncode:
        fallback = Path(__file__).resolve().parents[1]
        proc = run("git", "-C", str(fallback), "rev-parse", "--show-toplevel", check=False)
    if proc.returncode:
        raise Refusal("not inside a Hermes git checkout; pass --repo-path")
    return Path(proc.stdout.strip()).resolve()


def validate_repo(repo: Path) -> tuple[str, str]:
    if run("git", "status", "--porcelain", cwd=repo).stdout.strip():
        raise Refusal("checkout is dirty; commit the exact bytes before remote execution")

    branch = run("git", "branch", "--show-current", cwd=repo).stdout.strip()
    if not branch:
        raise Refusal("detached HEAD is not dispatchable; use a pushed branch")

    origin = run("git", "remote", "get-url", "origin", cwd=repo).stdout.strip()
    normalized = origin.removesuffix(".git").replace("git@github.com:", "https://github.com/")
    if normalized != f"https://github.com/{REMOTE_REPO}":
        raise Refusal(f"origin must be {REMOTE_REPO}, found {origin}")

    head = run("git", "rev-parse", "HEAD", cwd=repo).stdout.strip()
    remote = run(
        "git", "ls-remote", "--heads", "origin", f"refs/heads/{branch}", cwd=repo
    ).stdout.strip()
    remote_head = remote.split()[0] if remote else ""
    if remote_head != head:
        raise Refusal(
            f"branch {branch!r} is not pushed at the current commit; "
            "push it before dispatch"
        )
    return branch, head


def validate_target(repo: Path, target: str) -> str:
    if not TARGET_RE.fullmatch(target) or ".." in target:
        raise Refusal("target must be one relative tests/...py path or exact :: node ID")
    file_part = target.split("::", 1)[0]
    if not (repo / file_part).is_file():
        raise Refusal(f"target file does not exist: {file_part}")
    return target


def dispatch(branch: str, request_id: str, mode: str, target: str) -> None:
    run(
        "gh", "workflow", "run", WORKFLOW,
        "--repo", REMOTE_REPO,
        "--ref", branch,
        "-f", f"request_id={request_id}",
        "-f", f"mode={mode}",
        "-f", f"target={target}",
    )


def find_run(request_id: str, head: str, timeout: int = 90) -> dict:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        proc = run(
            "gh", "run", "list",
            "--repo", REMOTE_REPO,
            "--workflow", WORKFLOW,
            "--event", "workflow_dispatch",
            "--limit", "30",
            "--json", "databaseId,displayTitle,headSha,status,conclusion,url",
        )
        for item in json.loads(proc.stdout):
            if request_id in item["displayTitle"] and item["headSha"] == head:
                return item
        time.sleep(3)
    raise Refusal(f"workflow dispatch was accepted but run {request_id} was not found")


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Run Hermes tests outside the live gateway in an isolated CI container."
    )
    parser.add_argument("target", nargs="?", help="tests/...py or exact :: node ID")
    parser.add_argument("--full", action="store_true", help="run eight isolated suite slices")
    parser.add_argument("--repo-path", help="Hermes checkout/worktree (default: current repo)")
    parser.add_argument("--no-wait", action="store_true", help="return after the run is queued")
    parser.add_argument("--timeout-minutes", type=int, default=50)
    args = parser.parse_args()

    try:
        if args.full and args.target:
            raise Refusal("--full and a narrow target are mutually exclusive")
        if not args.full and not args.target:
            raise Refusal("supply one narrow target, or use --full explicitly")
        if not 1 <= args.timeout_minutes <= 180:
            raise Refusal("--timeout-minutes must be between 1 and 180")

        repo = discover_repo(args.repo_path)
        target = "" if args.full else validate_target(repo, args.target)
        branch, head = validate_repo(repo)
        mode = "full" if args.full else "narrow"
        stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
        request_id = f"{stamp}-{os.getpid()}-{secrets.token_hex(3)}"

        dispatch(branch, request_id, mode, target)
        item = find_run(request_id, head)
        print(f"queued: {item['url']}")
        print(f"mode={mode} ref={branch} head={head[:12]} request={request_id}")
        if args.no_wait:
            return 0

        watched = subprocess.run(
            ["gh", "run", "watch", str(item["databaseId"]),
             "--repo", REMOTE_REPO, "--exit-status", "--interval", "10"],
            timeout=args.timeout_minutes * 60,
            check=False,
        )
        return watched.returncode
    except subprocess.TimeoutExpired:
        print("REFUSED: timed out waiting for isolated run; it may still be active", file=sys.stderr)
        return 124
    except Refusal as exc:
        print(f"REFUSED: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
