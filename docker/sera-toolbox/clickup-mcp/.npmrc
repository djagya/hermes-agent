# Same layout as `npm install -g`: direct deps at the top, everything else
# nested under them, so the package dir can move into /usr/local/lib/node_modules.
install-strategy=shallow
engine-strict=true

min-release-age=14
# @modelcontextprotocol/sdk 1.31.0 fixes CVE-2026-104850. clickup-mcp 1.8.0
# and 1.9.0 pin 1.15.1 exactly, hence the override. Remove when 1.31.0 is
# > 2wks old (rel 2026-09-28).
min-release-age-exclude[]=@modelcontextprotocol/sdk
