# Same layout as `npm install -g`: direct deps at the top, everything else
# nested under them, so the package dir can move into /usr/local/lib/node_modules.
install-strategy=shallow
engine-strict=true

min-release-age=14
# body-parser 2.4.0 fixes CVE-2026-111181 (via express 5.2.1 from the MCP SDK),
# hence the override. Remove when 2.4.0 is > 2wks old (rel 2026-10-22, clears
# 2026-11-05 11:39Z).
min-release-age-exclude[]=body-parser
