#!/opt/hermes/.venv/bin/python3
"""Local HTML/SVG -> PDF. Refuse URL fetches even inside the sandbox."""
from __future__ import annotations

import sys
from pathlib import Path


def _refusing_fetcher():
    """A URLFetcher that refuses every fetch.

    WeasyPrint 70 reads ``_fail_on_errors`` off the fetcher when a fetch
    raises, so a bare function crashes the render on the first refused
    resource; a URLFetcher subclass keeps refusal a logged warning.
    """
    from weasyprint.urls import URLFetcher

    class RefuseURLFetcher(URLFetcher):
        def fetch(self, url, headers=None):  # noqa: ARG002
            raise RuntimeError(f"refusing URL fetch: {url}")

    return RefuseURLFetcher()


def main(argv: list[str]) -> int:
    if len(argv) != 3:
        print("usage: weasyprint INPUT.html OUTPUT.pdf", file=sys.stderr)
        return 2
    src = Path(argv[1])
    dest = Path(argv[2])
    if src.suffix.lower() not in {".html", ".htm", ".svg"}:
        print("sera-weasyprint: only local html/svg", file=sys.stderr)
        return 2
    from weasyprint import HTML

    # Disk HTML has no HTTP charset hint; WeasyPrint then defaults to
    # Latin-1 and stores UTF-8 bytes as WinAnsi (Cyrillic becomes
    # mojibake). Local Sera documents are UTF-8.
    HTML(filename=str(src), encoding="utf-8", url_fetcher=_refusing_fetcher()).write_pdf(
        str(dest)
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
