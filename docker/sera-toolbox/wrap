#!/usr/bin/env bash
# PATH wrapper: run a libexec parser inside bubblewrap.
# Real binary: /usr/libexec/sera-toolbox/<basename>
# No unsandboxed fallback. Network tools are not installed as wrappers.
set -euo pipefail

tool="$(basename "$0")"
real="/usr/libexec/sera-toolbox/${tool}"
origin="${real}.origin"
if [ -f "$origin" ]; then
  real="$(tr -d '\n' < "$origin")"
fi
case "$real" in
  /usr/*|/bin/*|/opt/hermes/*|/usr/libexec/sera-toolbox/*) ;;
  *)
    echo "sera-toolbox: refuse origin ${real}" >&2
    exit 127
    ;;
esac
if [ ! -x "$real" ]; then
  echo "sera-toolbox: missing ${real}" >&2
  exit 127
fi

if ! command -v bwrap >/dev/null 2>&1; then
  echo "sera-toolbox: bubblewrap not installed" >&2
  exit 127
fi

cwd="$(pwd -P)"
out_dir="${SERA_SANDBOX_OUT:-$cwd}"
mkdir -p "$out_dir"

# Tool-specific hardened flags. Extra caller flags still apply
# except ffmpeg/ffprobe protocol_whitelist — wrap forces file-only.
extra=()
case "$tool" in
  gs|ghostscript)
    extra+=(-dSAFER -dNOPAUSE)
    ;;
  soffice|libreoffice)
    extra+=(--headless --norestore --nolockcheck --nofirststartwizard
            "-env:UserInstallation=file:///tmp/lo-profile")
    ;;
  ffmpeg)
    extra+=(-nostdin -protocol_whitelist file,pipe,crypto,data)
    ;;
  ffprobe)
    extra+=(-protocol_whitelist file,pipe,crypto,data)
    ;;
esac
if [ "$tool" = ffmpeg ] || [ "$tool" = ffprobe ]; then
  filtered=()
  skip_next=0
  for arg in "$@"; do
    if [ "$skip_next" = 1 ]; then
      skip_next=0
      continue
    fi
    case "$arg" in
      -protocol_whitelist=*) continue ;;
      -protocol_whitelist) skip_next=1; continue ;;
    esac
    filtered+=("$arg")
  done
  set -- "${filtered[@]}"
fi

# Reject archive-traversal args and zip-slip members before the sandbox.
case "$tool" in
  unzip|7z|7za|bsdtar)
    for arg in "$@"; do
      case "$arg" in
        /*|*".."*)
          echo "sera-toolbox: refusing absolute or parent-traversal path: ${arg}" >&2
          exit 2
          ;;
      esac
    done
    if ! python3 - "$@" <<'PY'
import sys, zipfile
from pathlib import Path
max_ratio = float(__import__("os").environ.get("SERA_SANDBOX_ZIP_RATIO", "100"))
max_uncomp = int(__import__("os").environ.get("SERA_SANDBOX_ZIP_MAX_BYTES", str(64 * 1024 * 1024)))
for arg in sys.argv[1:]:
    p = Path(arg)
    if not p.is_file() or not zipfile.is_zipfile(p):
        continue
    with zipfile.ZipFile(p) as z:
        raw = 0
        comp = 0
        for info in z.infolist():
            name = info.filename
            if name.startswith("/") or any(part == ".." for part in name.split("/")):
                sys.exit(2)
            raw += info.file_size
            comp += info.compress_size
        if raw > max_uncomp:
            sys.exit(3)
        if comp and (raw / comp) > max_ratio:
            sys.exit(3)
PY
    then
      echo "sera-toolbox: refusing zip-slip, bomb, or absolute archive member" >&2
      exit 2
    fi
    ;;
esac

# Never treat the child-HOME / runtime root as a document cwd.
case "$cwd" in
  /opt/data|/opt/data/home|/opt/data/home/*)
    echo "sera-toolbox: refusing cwd ${cwd} (secrets/runtime root)" >&2
    exit 2
    ;;
esac

# Per-tool wall clocks. Caller SERA_SANDBOX_TIMEOUT still wins.
case "$tool" in
  file|exiftool|identify|pdfinfo)
    timeout_s="${SERA_SANDBOX_TIMEOUT:-30}"
    as_bytes="${SERA_SANDBOX_AS_BYTES:-536870912}"
    ;;
  tesseract|ocrmypdf|soffice|libreoffice|pandoc)
    timeout_s="${SERA_SANDBOX_TIMEOUT:-180}"
    as_bytes="${SERA_SANDBOX_AS_BYTES:-2147483648}"
    ;;
  *)
    timeout_s="${SERA_SANDBOX_TIMEOUT:-120}"
    as_bytes="${SERA_SANDBOX_AS_BYTES:-1073741824}"
    ;;
esac
start_ns="$(date +%s%N)"
tmp_receipt="$(mktemp /tmp/sera-bwrap.XXXXXX.json)"
tmp_before="$(mktemp /tmp/sera-bwrap.XXXXXX.before)"
find "$out_dir" -xdev -type f -print0 2>/dev/null | sort -z > "$tmp_before" || true
# Debian snapshot bwrap rejected both --nproc and --rlimit-nproc.
# Detect optional flags; timeout already caps wall clock.
bwrap_extra=()
bwrap_help="$(bwrap --help 2>&1 || true)"
case "$bwrap_help" in
  *--rlimit-nproc*) bwrap_extra+=(--rlimit-nproc 64) ;;
esac
case "$bwrap_help" in
  *--rlimit-nofile*) bwrap_extra+=(--rlimit-nofile 1024) ;;
esac
case "$bwrap_help" in
  *--rlimit-as*) bwrap_extra+=(--rlimit-as "$as_bytes") ;;
esac
# shellcheck disable=SC2016
status=0
# env -i: no secrets, no Docker/SSH/MCP, no HERMES_HOME.
# cwd + out_dir only. tmpfs HOME/tmp. no network.
# Nested Docker: --unshare-pid + --proc remounts procfs and EPERMs
# because the container /proc is masked (kernel refuses a "revealing"
# procfs in the child userns). Do not unmask / systempaths=unconfined
# / privileged / seccomp=unconfined. Bind the container /proc and /dev
# instead. PID isolation stays the Hermes container's, not a nested
# pid ns. PATH puts libexec first so ocrmypdf/soffice spawn real
# parsers, not these wrappers (no nested bwrap).
env -i \
  PATH=/usr/libexec/sera-toolbox:/usr/bin:/bin \
  HOME=/tmp/home \
  TMPDIR=/tmp \
  LANG="${LANG:-C.UTF-8}" \
  LC_ALL="${LC_ALL:-C.UTF-8}" \
  MAGICK_CONFIGURE_PATH=/etc/sera-toolbox/ImageMagick \
  SAL_USE_VCLPLUGIN=svp \
  timeout --signal=KILL "$timeout_s" \
  bwrap \
    --unshare-user \
    --unshare-net \
    --unshare-uts \
    --unshare-ipc \
    --die-with-parent \
    --new-session \
    "${bwrap_extra[@]}" \
    --ro-bind /proc /proc \
    --dev-bind /dev /dev \
    --ro-bind-try /sys /sys \
    --tmpfs /tmp \
    --tmpfs /var/tmp \
    --tmpfs /run \
    --dir /tmp/home \
    --ro-bind-try /etc/passwd /etc/passwd \
    --ro-bind-try /etc/group /etc/group \
    --ro-bind-try /etc/nsswitch.conf /etc/nsswitch.conf \
    --ro-bind-try /etc/hosts /etc/hosts \
    --ro-bind-try /etc/localtime /etc/localtime \
    --ro-bind-try /etc/machine-id /etc/machine-id \
    --ro-bind-try /etc/magic /etc/magic \
    --ro-bind-try /etc/magic.mgc /etc/magic.mgc \
    --ro-bind-try /etc/alternatives /etc/alternatives \
    --ro-bind-try /etc/ld.so.cache /etc/ld.so.cache \
    --ro-bind-try /etc/ld.so.conf /etc/ld.so.conf \
    --ro-bind-try /etc/ld.so.conf.d /etc/ld.so.conf.d \
    --ro-bind-try /etc/papersize /etc/papersize \
    --ro-bind /usr /usr \
    --ro-bind /lib /lib \
    --ro-bind-try /lib64 /lib64 \
    --ro-bind /bin /bin \
    --ro-bind-try /sbin /sbin \
    --ro-bind /etc/sera-toolbox /etc/sera-toolbox \
    --ro-bind-try /etc/fonts /etc/fonts \
    --ro-bind-try /var/cache/fontconfig /var/cache/fontconfig \
    --ro-bind-try /usr/share/fonts /usr/share/fonts \
    --ro-bind-try /etc/ImageMagick-7 /etc/ImageMagick-7 \
    --ro-bind-try /etc/ImageMagick-6 /etc/ImageMagick-6 \
    --ro-bind-try /etc/libreoffice /etc/libreoffice \
    --ro-bind-try /etc/ghostscript /etc/ghostscript \
    --ro-bind-try /var/lib/ghostscript /var/lib/ghostscript \
    --ro-bind-try /var/lib/tesseract-ocr /var/lib/tesseract-ocr \
    --ro-bind-try /var/lib/libreoffice /var/lib/libreoffice \
    --bind "$cwd" "$cwd" \
    --bind "$out_dir" "$out_dir" \
    --chdir "$cwd" \
    -- "$real" "${extra[@]}" "$@" \
  || status=$?

end_ns="$(date +%s%N)"
elapsed_ms=$(( (end_ns - start_ns) / 1000000 ))

# Plan 5d: cap new files in the output bind. Pre-existing files stay.
max_out_bytes="${SERA_SANDBOX_OUT_MAX_BYTES:-268435456}"
max_out_files="${SERA_SANDBOX_OUT_MAX_FILES:-256}"
if ! python3 - "$tmp_before" "$out_dir" "$max_out_bytes" "$max_out_files" <<'PY'
import os, sys
from pathlib import Path
before_path, out_dir, max_bytes_s, max_files_s = sys.argv[1:5]
max_bytes = int(max_bytes_s)
max_files = int(max_files_s)
before = set()
raw = Path(before_path).read_bytes()
if raw:
    before.update(p.decode("utf-8", "surrogateescape") for p in raw.split(b"\0") if p)
new = []
for dirpath, dirnames, filenames in os.walk(out_dir):
    dirnames[:] = [d for d in dirnames if d not in (".", "..")]
    for name in filenames:
        p = os.path.join(dirpath, name)
        if p not in before:
            new.append(p)
total = 0
for p in new:
    try:
        total += os.path.getsize(p)
    except OSError:
        continue
if len(new) > max_files or total > max_bytes:
    for p in new:
        try:
            os.remove(p)
        except OSError:
            pass
    sys.exit(3)
PY
then
  echo "sera-toolbox: refusing oversized output (${max_out_bytes} bytes / ${max_out_files} files)" >&2
  rm -f "$tmp_before"
  exit 3
fi
rm -f "$tmp_before"

python3 - "$tool" "$status" "$elapsed_ms" "$tmp_receipt" "$@" <<'PY'
import hashlib, json, os, sys, time
from pathlib import Path
tool, status, elapsed_ms, dest = sys.argv[1], int(sys.argv[2]), int(sys.argv[3]), sys.argv[4]
args = sys.argv[5:]
paths = []
for a in args:
    p = Path(a)
    if p.is_file():
        h = hashlib.sha256(p.read_bytes()).hexdigest()
        paths.append({"path": str(p), "sha256": h, "bytes": p.stat().st_size})
receipt = {
    "tool": tool,
    "exit": status,
    "elapsed_ms": elapsed_ms,
    "ts": int(time.time()),
    "files": paths,
}
Path(dest).write_text(json.dumps(receipt, separators=(",", ":")) + "\n", encoding="utf-8")
# Never print the receipt on stdout. This wrapper is a PATH stand-in
# for the real tool; JSON on stdout breaks `tool | grep -q` (pipefail
# + BrokenPipeError) and pollutes `$(file …)` captures. File only.
if os.environ.get("SERA_SANDBOX_VERBOSE") == "1":
    print(json.dumps({"sera_sandbox_receipt": dest, **receipt}, separators=(",", ":")), file=sys.stderr)
PY

exit "$status"
