    "public_route_denied": {
      "code": "scope_denied",
      "status": 403
    },
    "public_origin_denied": {
      "code": "scope_denied",
      "status": 403
    },
    "public_cross_site": {
      "code": "scope_denied",
      "status": 403
    },
