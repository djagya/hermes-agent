  "timeouts": {
    "cdp_probe_timeout_s": 2.0,
    "cdp_discovery_budget_s": 7.0,
    "cdp_client_read_timeout_s": 10.0,
    "cdp_supervisor_start_s": 15.0,
    "supervisor_watchdog_stale_s": 30.0
  },
  "routes": [
    {
      "method": "GET",
      "path": "/v1/status",
      "auth": "controller",
      "body": [
        "?lease=|?lease_id=",
        "?slot=",
        "?task="
      ],
      "reply": "pool view (slots, queue_length, park_history, capture_guard_history, idle_recycles, decisions, timeouts, capabilities, handback_delivery {pending, failed, store_ok}) | ?slot= slot row | ?lease= slot row + lease_state=live + handoff_pending",
      "errors": [
        "lease_ended (lease_state ended|unknown, ended_by, ended_at)",
        "unknown_slot"
      ],
      "lanes": [
        "private"
      ],
      "refusal": "json"
    },
    {
      "method": "GET",
      "path": "/v1/handback/pending",
      "auth": "controller",
      "body": [
        "?event_id="
      ],
      "reply": "pending=true + the event body (event, session_id, slot_id, lease_id, resumed_lease_id|reason_code, event_id) while control still holds it undelivered | pending=false",
      "errors": [],
      "lanes": [
        "private"
      ],
      "refusal": "json"
    },
    {
      "method": "GET",
      "path": "/v1/capture-guard",
      "auth": "controller",
      "body": [
        "?slot="
      ],
      "reply": "slot_id, capture_blocked, capture_blocked_at, wipe_count, human_clear {at, principal}|null, payment_surface {locked, tabs, unverified, native_connected, claimed_at}, history",
      "errors": [
        "unknown_slot"
      ],
      "lanes": [
        "private"
      ],
      "refusal": "json"
    },
    {
      "method": "POST",
      "path": "/v1/acquire",
      "auth": "controller",
      "body": [
        "task",
        "mode",
        "identity",
        "qa_targets"
      ],
      "reply": "lease view (lease_id, slot_id, command_token, observe_token, cdp_path, browser_generation, ownership_epoch, wipe_count, profile_kind, capture_blocked) | queued ticket (queued, position, retry_after_s, error=busy)",
      "errors": [
        "fence_down",
        "slot_busy_human",
        "pool_exhausted",
        "cdp_not_ready"
      ],
      "lanes": [
        "private"
      ],
      "refusal": "json"
    },
    {
      "method": "POST",
      "path": "/v1/release",
      "auth": "controller",
      "body": [
        "lease_id",
        "command_token"
      ],
      "reply": "released, closed_transports",
      "errors": [
        "lease_ended",
        "token_not_current",
        "fence_down",
        "handoff_pending (deferred, not an error: the lease is kept until the handoff link is used or expires; treat as released-later, do not retry; deferred=true)",
        "slot_transient"
      ],
      "lanes": [
        "private"
      ],
      "refusal": "json"
    },
    {
