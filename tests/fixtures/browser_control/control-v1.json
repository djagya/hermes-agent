    },
    "slot_maintenance": {
      "code": "unavailable",
      "status": 409
    },
    "slot_transient": {
      "code": "busy",
      "status": 409
    },
    "pool_exhausted": {
      "code": "busy",
      "status": 409
    },
    "cdp_not_ready": {
