  "events": {
    "handback": {
      "to": "BROWSER_HANDBACK_NOTIFY_URL (POST, controller bearer)",
      "body": [
        "event",
        "session_id",
        "slot_id",
        "lease_id",
        "resumed_lease_id",
        "event_id"
      ]
    },
    "handoff_ended": {
      "to": "BROWSER_HANDBACK_NOTIFY_URL (POST, controller bearer)",
      "body": [
        "event",
        "session_id",
        "slot_id",
        "lease_id",
        "reason_code",
        "event_id"
      ],
      "reason_codes": [
        "human_ended",
        "link_expired",
        "expired_unused",
        "human_idle",
        "human_disconnected",
        "take_failed",
        "resume_failed",
        "recycled",
        "other"
      ]
    }
  },
  "cdp_methods": {
    "doc": "CDP methods the splice answers itself on every /devtools and /slot/{slot}/json/version WebSocket; never forwarded to Chrome. Errors use the CDP error shape {id, sessionId?, error {code -32000, message '<code>: ...'}}.",
    "methods": {
      "Hermes.claimPaymentSurface": {
        "params": "tabs [targetId, 1..8]: the top-level page targets holding the card documents (each must be a live page target); no other key",
        "result": "claimed=true, locked=true, tabs (the slot's whole owning-tab set)",
        "errors": [
          "payment_surface_unavailable"
        ],
