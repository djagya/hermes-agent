{
  "protocol": "browser-control.v1",
  "doc": "browser-control v1 contract: every route the control server answers (method, auth, body, reply, reasons it may refuse with), the frozen error codes, the reason table (code + HTTP status), the shared CDP timeout table and the events control sends. tests/test_control_contract.py proves server.py implements exactly these routes. The fork vendors this file pinned by sha.",
  "auth": {
    "controller": "Authorization: Bearer <controller key>; peer in BROWSER_CONTROLLER_PEERS; Serve headers refused",
    "controller_peer+command_token": "controller peer; the lease command token in ?tok=",
    "human": "private lane: Tailscale Serve principal; public lane: Cloudflare Access JWT, Origin and Sec-Fetch pinned",
    "human+observe_token": "human, plus the slot's current observe token in ?tok=",
    "human+handoff_origin": "human, plus Origin/Host/Sec-Fetch-Site equal to the handoff origin"
  },
  "errors": [
    "busy",
    "stale",
    "scope_denied",
    "unavailable"
  ],
  "reasons": {
    "lease_ended": {
      "code": "stale",
      "status": 403
    },
    "token_not_current": {
      "code": "stale",
      "status": 403
    },
    "lease_owner_mismatch": {
      "code": "stale",
